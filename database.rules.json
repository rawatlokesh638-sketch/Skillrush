{
  "rules": {
    "usernames": {
      ".read": "auth != null",
      "$username": {
        ".write": "auth != null"
      }
    },
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null"
      }
    },
    "leaderboards": {
      "$category": {
        "$timeframe": {
          ".read": "auth != null",
          ".indexOn": ["score"],
          "$uid": {
            ".write": "auth != null"
          }
        }
      }
    }
  }
}
